<b:skin><![CDATA[
/*
================================================================
NAUSCOPIO · TEMA BLOGGER - BASE
================================================================
Versión:      V8.9 GSC FINAL FIX AUDIT 2 - minúsculas + mnav-auto + theme fix + lightbox provisional - canonical fix + og S1600 + hreflang real + logos reales 1200/600/180, og:image S1600, hreflang real, BlogPosting movil eliminado, itemprop limpio — OG width/height + canonical + hreflang + BlogPosting eliminado — fix CSS details/summary
Fecha:        2026-10-21
Alcance:      base para todas las páginas (home, kiosco, posts, índices, informes)
Contenido:    01 Reset, 02 Layout, 03 Paginación, 04 Tipografía, 05 Laterales, 06 Fix Anexos
Nota:         report.css (06-08) y initP52.js se cargan condicionalmente
              solo en item/static_page vía jsDelivr
================================================================
*/

/* ============================================================
   01. RESET BASE DEL BLOG
   ============================================================ */
* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }
body {
  background: #F8F8F8;
  font-family: Verdana, Helvetica, Arial, Sans-serif;
  color: #000;
  margin: 0;
  padding: 0;
  min-height: 100vh;
  min-height: 100dvh;
}
img { max-width: 100%; height: auto; }
a, a:link, a:visited { color: #033A7E; text-decoration: none; }
a:hover { background: #0A7EA5; color: #FFF; border-radius: 3px; }

/* ============================================================
   02. LAYOUT GLOBAL
   ============================================================ */
#outer-wrapper {
  max-width: 1920px;
  width: 100%;
  margin: 0 auto;
  padding: 0 4px;
  background: #FBE4BF;
}
.titlewrapper {
  border: 3px double #CCC;
  background: #593C49;
  margin: 10px;
  color: #FFF;
  font: bold 110% Garamond, Georgia, Sans-serif;
  text-align: center;
}
.post-outer { background: #FBE4BF; padding-left: 6px; }
.post { padding: 1% 1% 0 .5%; background: #FBE4BF; }
#main .widget { padding-bottom: 10px; margin-bottom: 20px; clear: both; }
.post-footer, .feed-links, h3.post-title, h2.date-header { display: none; }
.clear { clear: both; }
.profile-img { float: left; margin: 0 5px 5px 0; }
#b-navbar, #navbar { display: none; }
#cookieChoiceInfo, .cookie-choices-info {
  display: none !important;
  visibility: hidden !important;
  opacity: 0 !important;
  pointer-events: none !important;
}

/* ============================================================
   03. PAGINACIÓN DEL BLOG
   ============================================================ */
#blog-pager { display: block; padding: 10px 0; text-align: center; }
#blog-pager .home-link,
#blog-pager #blog-pager-home-link .home-link {
  display: inline-block;
  min-height: 34px;
  padding: 8px 20px;
  margin: 6px;
  border-radius: 999px;
  font: bold 11px/1.4 Verdana, Helvetica, Arial, Sans-serif;
  letter-spacing: .12em;
  text-transform: uppercase;
  background: #593C49;
  color: #FFF;
  border: 1px solid #593C49;
  box-shadow: 0 2px 6px rgba(89, 60, 73, .28);
  transition: background .22s ease, border-color .22s ease;
}
#blog-pager .home-link:hover,
#blog-pager .home-link:focus,
#blog-pager #blog-pager-home-link .home-link:hover {
  background: #0A7EA5;
  border-color: #0A7EA5;
  color: #FFF;
  text-decoration: none;
}
#blog-pager .blog-pager-newer-link,
#blog-pager .blog-pager-older-link {
  display: inline-block;
  min-height: 34px;
  padding: 8px 18px;
  margin: 6px;
  border-radius: 999px;
  font: bold 11px/1.4 Verdana, Helvetica, Arial, Sans-serif;
  letter-spacing: .12em;
  text-transform: uppercase;
  background: #F6F6F6;
  color: #033A7E;
  border: 1px solid #DADADA;
  transition: background .22s ease, color .22s ease, border-color .22s ease;
}
#blog-pager .blog-pager-newer-link:hover,
#blog-pager .blog-pager-older-link:hover {
  background: #0A7EA5;
  color: #FFF;
  border-color: #0A7EA5;
}

/* ============================================================
   04. TIPOGRAFÍA DEL BLOG
   ============================================================ */
h1 {
  color: #000;
  font: bold 220% Garamond, Georgia, Sans-serif;
  line-height: 1.1em;
  letter-spacing: .12em;
  text-transform: uppercase;
}
h1 a, h1 a:link, h1 a:visited { color: #FFF; }
h2 { font: bold 20px Verdana, Helvetica, Sans-serif; }
h3.entry-title { padding: 10px 0 0 14px; letter-spacing: .10em; }
h3.entry-title a { padding: 0; color: #593C49; }
h3.entry-title a:hover { color: #FFF; }
li { margin: 10px; }
td { font-size: 13px; }
td h4 { margin: 4px 0 0 0; font: bold 110% Garamond, Georgia, Sans-serif; letter-spacing: .05em; }

/* ============================================================
   05. CONTENEDORES LATERALES Y AUXILIARES
   ============================================================ */

/* ============================================================
   06. FIX PARA LOS ANEXOS (DETAILS/SUMMARY) - V8.8
   ============================================================ */
details.part-collapse summary {
  display: flex !important;
  justify-content: flex-start !important;
  align-items: center !important;
  cursor: pointer;
  list-style: none;
}
details.part-collapse summary::-webkit-details-marker {
  display: none;
}
details.part-collapse summary::before {
  content: "\25B8" !important; /* El código CSS correcto para el triángulo ▸ */
  display: inline-block !important;
  transition: transform .2s !important;
  font-size: 1.1em !important;
  margin-right: 8px !important;
}
details.part-collapse[open] summary::before {
  transform: rotate(90deg) !important;
}
details.part-collapse summary::after {
  display: none !important; /* Oculta la flecha que el tema pone a la derecha */
}

